<?xml version="1.0" encoding="UTF-8"?>
<xesextension name="Space" prefix="space" uri="space.xesext">
  <!-- Spatial attributes for events: coordinates, CRS, locations, and network edges. -->
  <log>
    <string key="crs">
      <!-- Log-level default CRS, e.g. "EPSG:4326" or "LOCAL_METERS". -->
      <alias mapping="EN" name="Coordinate Reference System" />
      <alias mapping="DE" name="Koordinatenreferenzsystem" />
      <alias mapping="TR" name="Koordinat Referans Sistemi" />
      <alias mapping="FR" name="Système de Référence de Coordonnées" />
      <alias mapping="ES" name="Sistema de Referencia de Coordenadas" />
      <alias mapping="PT" name="Sistema de Referência de Coordenadas" />
    </string>
  </log>
  <trace />
  <event>
    <float key="x">
      <!-- Horizontal coordinate (longitude for WGS84, easting for UTM, x for local). -->
      <alias mapping="EN" name="X Coordinate" />
      <alias mapping="DE" name="X-Koordinate" />
      <alias mapping="TR" name="X Koordinatı" />
      <alias mapping="FR" name="Coordonnée X" />
      <alias mapping="ES" name="Coordenada X" />
      <alias mapping="PT" name="Coordenada X" />
    </float>
    <float key="y">
      <!-- Vertical coordinate (latitude for WGS84, northing for UTM, y for local). -->
      <alias mapping="EN" name="Y Coordinate" />
      <alias mapping="DE" name="Y-Koordinate" />
      <alias mapping="TR" name="Y Koordinatı" />
      <alias mapping="FR" name="Coordonnée Y" />
      <alias mapping="ES" name="Coordenada Y" />
      <alias mapping="PT" name="Coordenada Y" />
    </float>
    <string key="level">
      <!-- Floor or vertical layer, e.g. "F1", "Ground". -->
      <alias mapping="EN" name="Vertical Level" />
      <alias mapping="DE" name="Ebene" />
      <alias mapping="TR" name="Düzey" />
      <alias mapping="FR" name="Niveau" />
      <alias mapping="ES" name="Nivel" />
      <alias mapping="PT" name="Nível" />
    </string>
    <string key="crs">
      <!-- Event-level CRS override. -->
      <alias mapping="EN" name="Coordinate Reference System" />
      <alias mapping="DE" name="Koordinatenreferenzsystem" />
      <alias mapping="TR" name="Koordinat Referans Sistemi" />
      <alias mapping="FR" name="Système de Référence de Coordonnées" />
      <alias mapping="ES" name="Sistema de Referencia de Coordenadas" />
      <alias mapping="PT" name="Sistema de Referência de Coordenadas" />
    </string>
    <string key="location">
      <!-- Discrete location ID (station, node, zone, room). -->
      <alias mapping="EN" name="Location Identifier" />
      <alias mapping="DE" name="Standortkennung" />
      <alias mapping="TR" name="Konum Tanımlayıcısı" />
      <alias mapping="FR" name="Identifiant de Lieu" />
      <alias mapping="ES" name="Identificador de Ubicación" />
      <alias mapping="PT" name="Identificador de Local" />
    </string>
  </event>
</xesextension>