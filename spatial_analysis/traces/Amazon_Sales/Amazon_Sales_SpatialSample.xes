<?xml version="1.0" encoding="utf-8" ?>
<!-- Sample: 3 real orders with zone-based spatial attrs (city/state/postal/country) -->
<log xmlns="http://www.xes-standard.org/" xes.version="1849-2016" xes.features="nested-attributes">
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <extension name="Lifecycle" prefix="lifecycle" uri="http://www.xes-standard.org/lifecycle.xesext"/>
  <string key="concept:name" value="Amazon Sales India - Spatial Sample"/>
  <string key="spatial:style" value="zone"/>
  <classifier name="Activity" keys="concept:name"/>
  <trace>
    <string key="concept:name" value="171-0006482-2020369"/>
    <string key="space:city" value="HALDIA"/>
    <string key="space:state" value="WEST BENGAL"/>
    <string key="space:postal_code" value="721607"/>
    <string key="space:country" value="IN"/>
    <string key="final_status" value="Shipped - Delivered To Buyer"/>
    <string key="fulfilment" value="MERCHANT"/>
    <string key="ship_service_level" value="STANDARD"/>
    <event>
      <string key="concept:name" value="Order Placed"/>
      <date key="time:timestamp" value="2022-04-24T05:35:48.823587+00:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Payment Confirmed"/>
